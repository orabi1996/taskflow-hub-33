# ==============================================================================
# Environment Configuration Template (.env.example)
# TaskFlow Hub / CRM (C-SmarX)
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit .env or secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Public Client Configuration (Safe for client/Vite bundle)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
SUPABASE_PROJECT_ID="your-project-id"

VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# ------------------------------------------------------------------------------
# 2. Supabase Server Service Role (SERVER-SIDE ONLY - CRITICAL SECRET)
# Never expose this value to the browser or client-side code.
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_service_role_key_here"

# ------------------------------------------------------------------------------
# 3. Webhook & Cron Security Secrets (SERVER-SIDE ONLY)
# Used to authenticate scheduled jobs (/api/public/hooks/automation-tick, /api/public/hooks/contract-alerts)
# Provide via 'Authorization: Bearer <SECRET>' or 'x-cron-secret: <SECRET>'
# ------------------------------------------------------------------------------
CRON_SECRET="your-strong-random-cron-secret-min-32-chars"
# Optional overrides for specific webhooks:
# AUTOMATION_WEBHOOK_SECRET="your-automation-secret"
# CONTRACT_ALERTS_SECRET="your-contract-alerts-secret"
# SMTP_TEST_SECRET="your-smtp-test-secret"

# ------------------------------------------------------------------------------
# 4. Admin Bootstrap / Seeding Configuration (SERVER-SIDE ONLY)
# Set ADMIN_BOOTSTRAP_ENABLED="true" ONLY during initial environment setup.
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_ENABLED="false"
ADMIN_BOOTSTRAP_SECRET="your-strong-bootstrap-secret-min-32-chars"
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="ChangeMeImmediately!123"
ADMIN_SEED_FULL_NAME="System Administrator"
# Optional safety override to allow updating an existing admin during bootstrap:
# ALLOW_ADMIN_RESET="false"

# ------------------------------------------------------------------------------
# 5. Session Cookie Security (SERVER-SIDE ONLY)
# Used to HMAC-sign HttpOnly session cookies. If unset, SUPABASE_SERVICE_ROLE_KEY is used.
# ------------------------------------------------------------------------------
SESSION_SECRET="your-strong-random-session-secret-min-32-chars"

# ------------------------------------------------------------------------------
# 6. Lovable AI Gateway (Optional, SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
LOVABLE_API_KEY=""
